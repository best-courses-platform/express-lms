# npm ci по умолчанию сам гоняет npm audit при каждой установке - в этом проекте это
# дублирует выделенный job `audit` (npm audit --audit-level=high) в ci.yml, который
# запускает его осознанно и с порогом. Без этой строки implicit-аудит молча выполнялся бы
# ещё и в lint/typecheck/test/build/e2e - без порога и без всякого эффекта.
audit=false
