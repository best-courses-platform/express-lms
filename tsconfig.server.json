{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*",
    "src/@types/**/*.d.ts"
  ],
  "exclude": [
    "src/public/**/*",
    "src/**/__tests__/**/*",
    "src/**/__mocks__/**/*",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist"
  ]
}
